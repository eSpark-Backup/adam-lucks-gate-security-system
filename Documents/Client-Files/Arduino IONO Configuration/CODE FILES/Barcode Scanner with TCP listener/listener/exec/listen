#!/bin/bash
#
# TCP Listener - looping script
# This script is executed on each NEW connection
#
# @author Alex D. 
# @link https://www.upwork.com/o/profiles/users/_~0170b9b80bdefdcd81/
#



SCRIPTDIR=$(cd `dirname $0` && pwd)
cd "$SCRIPTDIR"

## Default values
desc=''
VER='0.4'
RELAY_TRIGGER_SECONDS="10"


#######################################################



### New connection
### This should be the device identifier: Scanner N
read IDENTIFIER

## Strips Whitespace and other undesired characters
IDENTIFIER=${IDENTIFIER//[^[:alnum:]]/}
[ -z "$IDENTIFIER" ] && exit 1;

## Validate the identifier
if [[ ! "$IDENTIFIER" =~ ^Scanner([0-9]*)$ ]]; then	
	echo "BYE"
	exit 1
fi

LOGF="$SCRIPTDIR/../log/$IDENTIFIER.log"
ENVF="$SCRIPTDIR/../log/$IDENTIFIER.env"
PIDF="$SCRIPTDIR/../run/$IDENTIFIER.pid"


## Is the same identifier already connected?
if [ -f "$PIDF" ]; then	
	## Collision: A scanner with the same identifier is already connected! 
	## It might be a dead connection. We need to wait for that connection to close
	TIMESTAMP=`date "+%Y-%m-%d %H:%M:%S"`
	echo "[$TIMESTAMP] > < $IDENTIFIER" >> "$SCRIPTDIR/../log/COLLISIONS.log"
	sleep 15
	echo "BYE"
	exit 1
fi



#######################################################



## Sends commands back
function sendCmd(){
	cmd="$@"
	cmd=${cmd//[[:blank:]]/}
	if [ "$cmd" = "%" ]; then
		printf "%%\r"	
	else
		printf "$cmd\r"
	fi
	if [ -z "$desc" ]; then		
		echo "<< $cmd" >> $LOGF
	else 		
		echo "<< $cmd   ( $desc )" >> $LOGF
	fi
	read -t 15 MESSAGE	
	MESSAGE=${MESSAGE//[^[:alnum:] ._-]/}
	if [ -z "$MESSAGE" -o "$MESSAGE" = "NOK" ]; then
		echo "   >> [FAIL] $cmd" >> $LOGF
	else		
		echo " >> $MESSAGE" >> $LOGF
	fi
}


function lockExitTrap () {
	#Don't recurse in the exit trap
	trap - INT TERM EXIT
	#remove the pid file cleanly on exit
	rm -f "$1" &> /dev/null
	exit
}



## Init
################################################################

## The config
source "../conf/listen.conf"

## Clear the log file
## One file per scanner, cleared on each connect
echo "$IDENTIFIER" > $LOGF
TIMESTAMP=`date "+%Y-%m-%d %H:%M:%S"`
echo "[$TIMESTAMP] - Listener Version $VER" >> $LOGF

## Save the env for debuging
printenv > "$ENVF"

## Save the PID 
echo "$$" > "$PIDF"

## Deletes the PIDF on exit
trap "{ lockExitTrap \"\$PIDF\" ; }" INT TERM EXIT


## This is required to debug new connections without disconnecting existing ones
[ -f "$SCRIPTDIR/debug" ] && source "$SCRIPTDIR/debug"


## Blinks the bicolor led for xx seconds
sendCmd "(05"


#### Listener Loop
################################################################
while true
do
	## Now listen for any messages
	read -t 100 MESSAGE
	MESSAGE=${MESSAGE//[^[:alnum:] ._-]/}
	if [ -n "$MESSAGE" ]; then
		
		TIMESTAMP=`date "+%Y-%m-%d %H:%M:%S"`
		echo "[$TIMESTAMP] >>>> $MESSAGE" >> $LOGF

		case "$MESSAGE" in

			bye|BYE)
				echo "BYE"
				exit 0
			;;

			ver|VER)
				sendCmd "$VER"
			;;

			#>:S1C Sense Input 1 Low	= BLACK +++ Blue
			S1C)
				sensorEventS1C
			;;

			#>:S1O Sense Input 1 High	= BLACK < > Blue
			S1O)
				sensorEventS1O
			;;

			#>:S2C Sense Input 2 Low	= WHITE +++ Blue
			S2C)
				sensorEventS2C
			;;

			#>:S2O Sense Input 2 High	= WHITE < > Blue
			S2O)
				sensorEventS2O
			;;

			## $MESSAGE is a BARCODE
			*) 

				## Sanitize the BarCode (numbers only):				
				BarCode=${MESSAGE//[^[:digit:]]/}
				echo "$BarCode" >> $LOGF
				if [ "$BarCode" = "$MESSAGE" ] && [ -n "$BarCode" ]; then
					echo "Inside Function" >> $LOGF 					
					barcodeReceived "$MESSAGE" "$IDENTIFIER"
				fi


			;;
		esac

	else

		## Send a bogus command to check if the scanner is still online		
		printf "V\r"
		read -t 3 MESSAGE
		MESSAGE=${MESSAGE//[^[:alnum:] ._-]/}
		if [ -z "$MESSAGE" ]; then
			TIMESTAMP=`date "+%Y-%m-%d %H:%M:%S"`
			echo "[$TIMESTAMP] Offline!" >> $LOGF
			echo "Disconnecting $IDENTIFIER" >> $LOGF
			echo "Offline!"
			exit 1
		fi


	fi

done












exit 0
